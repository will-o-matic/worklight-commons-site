---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, LEGAL_NAME } from '../data/site.ts';

const updated = 'October 8, 2026';
---
<Base title="Privacy" description="How the Worklight Commons website handles your information. Short version: it collects nothing.">
  <section class="section">
    <div class="wrap"><div class="prose">
      <h1>Privacy</h1>
      <p class="meta">Last updated {updated}</p>
      <p class="lede">
        Short version: this website doesn't collect, store, or sell information about you.
      </p>

      <h2>What this policy covers</h2>
      <p>
        This policy covers worklightcommons.com, the website of {LEGAL_NAME}. Each of our apps, such as Knit Life
        Manager, has its own privacy policy on its own site, and this page doesn't cover them.
      </p>

      <h2>What we collect</h2>
      <ul>
        <li>No cookies, analytics, advertising, or tracking scripts.</li>
        <li>No accounts, sign-ups, or forms.</li>
        <li>Fonts and images are served from this site, not from third parties.</li>
      </ul>

      <h2>If you email us</h2>
      <p>
        If you write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, we use your message and email address
        only to reply to you. We don't sell or share them, and we don't add you to any mailing list. Our email provider
        processes messages to deliver them.
      </p>

      <h2>Hosting</h2>
      <p>
        This site is hosted on GitHub Pages. Like most web hosts, GitHub may log technical information such as
        visitor IP addresses to keep the service secure. See the
        <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub General Privacy Statement</a>
        for details.
      </p>

      <h2>Changes</h2>
      <p>If this policy changes, we'll update this page and the date at the top.</p>

      <h2>Questions</h2>
      <p>Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> with any privacy question.</p>
    </div></div>
  </section>
</Base>
